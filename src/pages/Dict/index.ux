  width: 100%;
  height: 60 * $size-factor;
  justify-content: center;
  align-items: center;
  margin-top: 20 * $size-factor;
}

.loading-text {
  font-size: 15 * $size-factor;
  color: $brand;
}

.result-area {
  flex: 1;
  width: 100%;
