  flex: 1;
  height: 40 * $size-factor;
  background-color: #1e1e36;
  border-radius: 20 * $size-factor;
  color: #ffffff;
  font-size: 15 * $size-factor;
  padding-left: 14 * $size-factor;
  padding-right: 14 * $size-factor;
  line-height: 40 * $size-factor;
}

