<!--
  全能词典 V1.2.0
  适配 iQOO Watch GT2 / Blue OS 3.0
  新增：离线激活、拼音输入法（26/9键、中英切换）、系统键盘切换
-->

<template>
  <div class="page">
    <!-- 顶部标题 + 输入法切换 -->
    <div class="header">
      <text class="app-title">全能词典</text>
      <text class="ime-switch" onclick="onToggleIME">
        {{ useCustomKB ? '系统键盘' : '拼音键盘' }}
      </text>
    </div>

    <!-- 搜索区域 -->
    <div class="search-area">
      <!-- 自定义键盘模式：用 text 展示输入内容 -->
      <text class="search-input-text" if="{{ useCustomKB }}" onclick="showKeyboard">
        {{ keyword || '点击输入...' }}
      </text>
      <!-- 系统键盘模式：用原生 input -->
      <input
        class="search-input"
        else
        type="text"
        placeholder="输入单词..."
        value="{{ keyword }}"
        onchange="onKeywordChange"
      />
      <input
        class="search-btn"
        type="button"
        value="查询"
        onclick="onSearch"
      />
    </div>

    <!-- 快捷单词 -->
    <div class="quick-words" if="{{ !showKB }}">
      <text
        class="quick-word"
        for="{{ quickWords }}"
        onclick="onQuickWord($item)"
      >{{ $item }}</text>
    </div>

    <!-- 加载中 -->
    <div class="loading" if="{{ loading }}">
      <text class="loading-text">查询中...</text>
    </div>

    <!-- 查询结果 -->
    <scroll class="result-area" if="{{ result && !loading && !showKB }}">
      <div class="result-word">
        <text class="word-text">{{ result.word }}</text>
        <text class="phonetic-text" if="{{ result.phonetic }}">{{ result.phonetic }}</text>
      </div>

      <div class="meaning-list" for="{{ result.meanings }}">
        <text class="pos-text">{{ $item.partOfSpeech }}</text>
        <div class="def-list" for="{{ $item.definitions }}">
          <text class="def-text">• {{ $item.definition }}</text>
          <text class="example-text" if="{{ $item.example }}">例：{{ $item.example }}</text>
        </div>
      </div>
    </scroll>

    <!-- 空状态 -->
    <div class="empty" if="{{ !result && !loading && !showKB }}">
      <text class="empty-text">输入单词或中文开始查询</text>
      <text class="empty-sub">支持英文释义、中文翻译</text>
    </div>

    <!-- 错误提示 -->
    <div class="error" if="{{ errorMsg && !loading }}">
      <text class="error-text">{{ errorMsg }}</text>
    </div>

    <!-- 自定义拼音键盘 -->
    <PinyinKeyboard
      if="{{ useCustomKB && showKB }}"
      oninput="onKBInput"
      onbackspace="onKBBackspace"
      onconfirm="onKBConfirm"
      onhide="onKBHide"
    ></PinyinKeyboard>
  </div>
</template>

<script>
import dictionary from '../../helper/apis/dictionary'
import PinyinKeyboard from '../../components/PinyinKeyboard/index.ux'

export default {
  components: {
    PinyinKeyboard
  },

  private: {
    keyword: '',
    loading: false,
    result: null,
    errorMsg: '',
    quickWords: ['hello', 'world', 'apple', '你好', '学习'],
    useCustomKB: true, // 是否使用自定义拼音键盘
    showKB: false // 是否显示键盘
  },

  onKeywordChange(e) {
    this.keyword = e.value
  },

  // 输入法切换（自定义拼音键盘 / 系统键盘）
  onToggleIME() {
    this.useCustomKB = !this.useCustomKB
    this.showKB = false
    if (this.useCustomKB) {
      // 切换到自定义键盘时，清空系统输入
    }
  },

  showKeyboard() {
    this.showKB = true
  },

  // 自定义键盘输入
  onKBInput(e) {
    const text = e.detail || e
    this.keyword += text
  },

  onKBBackspace() {
    this.keyword = this.keyword.slice(0, -1)
  },

  onKBConfirm() {
    this.showKB = false
    this.onSearch()
  },

  onKBHide() {
    this.showKB = false
  },

  onQuickWord(word) {
    this.keyword = word
    this.showKB = false
    this.search(word)
  },

  onSearch() {
    const word = (this.keyword || '').trim()
    if (!word) {
      this.errorMsg = '请输入要查询的内容'
      this.result = null
      return
    }
    this.search(word)
  },

  search(word) {
    this.loading = true
    this.errorMsg = ''
    this.result = null

    // 判断是中文还是英文
    if (dictionary.hasChinese(word)) {
      // 中文：翻译为英文
      dictionary
        .translateZhToEn(word)
        .then((data) => {
          this.result = data
        })
        .catch((err) => {
          this.errorMsg = err.message || '翻译失败'
        })
        .finally(() => {
          this.loading = false
        })
    } else {
      // 英文：查词典
      dictionary
        .lookupWord(word)
        .then((data) => {
          if (data) {
            this.result = data
          } else {
            this.errorMsg = '未查询到结果'
          }
        })
        .catch((err) => {
          this.errorMsg = err.message || '查询失败'
        })
        .finally(() => {
          this.loading = false
        })
    }
  }
}
</script>

<style lang="scss">
