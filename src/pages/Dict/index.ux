  width: 100%;
  flex-direction: column;
  margin-bottom: 10 * $size-factor;
  background-color: #1a1a33;
  border-radius: 12 * $size-factor;
  padding: 10 * $size-factor;
}

.pos-text {
  font-size: 14 * $size-factor;
  color: $brand;
  font-weight: bold;
  margin-bottom: 6 * $size-factor;
}

.def-list {
