  flex: 1;
  height: 44 * $size-factor;
  background-color: #1e1e36;
  border-radius: 22 * $size-factor;
  color: #ffffff;
  font-size: 16 * $size-factor;
  padding-left: 16 * $size-factor;
  padding-right: 16 * $size-factor;
}

