<!--
  全能词典 V1.0.4
  适配 iQOO Watch GT2 / Blue OS 3.0
  优化：减少条件渲染、简化布局
-->

<template>
  <div class="page">
    <!-- 顶部标题 + 输入法切换 -->
    <div class="header">
      <text class="app-title">全能词典</text>
      <div class="header-right">
        <text class="ime-switch" onclick="onToggleIME">{{ useCustomKB ? '系统键盘' : '拼音键盘' }}</text>
        <text class="settings-btn" onclick="onSettings">⚙</text>
      </div>
    </div>

    <!-- 搜索区域 -->
    <div class="search-area">
      <text class="search-input-text" if="{{ useCustomKB }}" onclick="showKeyboard">{{ keyword || '点击输入...' }}</text>
      <input class="search-input" else type="text" placeholder="输入单词..." value="{{ keyword }}" onchange="onKeywordChange" />
      <input class="search-btn" type="button" value="查询" onclick="onSearch" />
    </div>

    <!-- 快捷单词（仅在无键盘时显示） -->
    <div class="quick-words" if="{{ !showKB && !result && !loading }}">
      <text class="quick-word" for="{{ quickWords }}" onclick="onQuickWord($item)">{{ $item }}</text>
    </div>

    <!-- 加载中 -->
    <div class="loading" if="{{ loading }}">
      <text class="loading-text">查询中...</text>
    </div>

    <!-- 查询结果 -->
    <div class="result-area" if="{{ result && !loading && !showKB }}">
      <text class="word-text">{{ result.word }}</text>
      <text class="phonetic-text" if="{{ result.phonetic }}">{{ result.phonetic }}</text>
      <div class="meaning-list" for="{{ result.meanings }}">
        <text class="pos-text">{{ $item.partOfSpeech }}</text>
        <text class="def-text" for="{{ $item.definitions }}">• {{ $item.definition }}</text>
      </div>
    </div>

    <!-- 自定义拼音键盘 -->
    <PinyinKeyboard if="{{ useCustomKB && showKB }}" oninput="onKBInput" onbackspace="onKBBackspace" onconfirm="onKBConfirm" onhide="onKBHide"></PinyinKeyboard>
  </div>
</template>

<script>
import dictionary from '../../helper/apis/dictionary'
import PinyinKeyboard from '../../components/PinyinKeyboard/index.ux'
import router from '@system.router'

export default {
  components: {
    PinyinKeyboard
  },

  private: {
    keyword: '',
    loading: false,
    result: null,
    quickWords: ['hello', 'world', 'apple', '你好', '学习'],
    useCustomKB: true,
    showKB: false
  },

  onKeywordChange(e) {
    this.keyword = e.value
  },

  onToggleIME() {
    this.useCustomKB = !this.useCustomKB
    this.showKB = false
  },

  onSettings() {
    this.showKB = false
    router.push({ uri: '/pages/Settings' })
  },

  showKeyboard() {
    this.showKB = true
  },

  onKBInput(e) {
    const text = e.detail || e
    this.keyword += text
  },

  onKBBackspace() {
    this.keyword = this.keyword.slice(0, -1)
  },

  onKBConfirm() {
    this.showKB = false
    this.onSearch()
  },

  onKBHide() {
    this.showKB = false
  },

  onQuickWord(word) {
    this.keyword = word
    this.showKB = false
    this.search(word)
  },

  onSearch() {
    const word = (this.keyword || '').trim()
    if (!word) {
      this.result = null
      return
    }
    this.search(word)
  },

  search(word) {
    this.loading = true
    this.result = null

    if (dictionary.hasChinese(word)) {
      dictionary
        .translateZhToEn(word)
        .then((data) => {
          this.result = data
        })
        .catch(() => {
          this.result = null
        })
        .finally(() => {
          this.loading = false
        })
    } else {
      dictionary
        .lookupWord(word)
        .then((data) => {
          this.result = data || null
        })
        .catch(() => {
          this.result = null
        })
        .finally(() => {
          this.loading = false
        })
    }
  }
}
</script>

