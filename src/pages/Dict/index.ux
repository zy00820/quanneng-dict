  flex-direction: row;
  width: 100%;
  height: 56 * $size-factor;
  align-items: center;
  justify-content: center;
  padding-left: 12 * $size-factor;
  padding-right: 12 * $size-factor;
  margin-top: 4 * $size-factor;
}

