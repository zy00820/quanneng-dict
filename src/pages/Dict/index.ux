<!--
  全能词典 V1.0.0
  适配 iQOO Watch GT2 / Blue OS 3.0
-->

<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="app-title">全能词典</text>
    </div>

    <!-- 搜索区域 -->
    <div class="search-area">
      <input
        class="search-input"
        type="text"
        placeholder="输入单词..."
        value="{{ keyword }}"
        onchange="onKeywordChange"
      />
      <input
        class="search-btn"
        type="button"
        value="查询"
        onclick="onSearch"
      />
    </div>

    <!-- 快捷单词 -->
    <div class="quick-words">
      <text
        class="quick-word"
        for="{{ quickWords }}"
        onclick="onQuickWord($item)"
      >{{ $item }}</text>
    </div>

    <!-- 加载中 -->
    <div class="loading" if="{{ loading }}">
      <text class="loading-text">查询中...</text>
    </div>

    <!-- 查询结果 -->
    <scroll class="result-area" if="{{ result && !loading }}">
      <div class="result-word">
        <text class="word-text">{{ result.word }}</text>
        <text class="phonetic-text" if="{{ result.phonetic }}">{{ result.phonetic }}</text>
      </div>

      <div class="meaning-list" for="{{ result.meanings }}">
        <text class="pos-text">{{ $item.partOfSpeech }}</text>
        <div class="def-list" for="{{ $item.definitions }}">
          <text class="def-text">• {{ $item.definition }}</text>
          <text class="example-text" if="{{ $item.example }}">例：{{ $item.example }}</text>
        </div>
      </div>
    </scroll>

    <!-- 空状态 -->
    <div class="empty" if="{{ !result && !loading }}">
      <text class="empty-text">输入英文单词开始查询</text>
      <text class="empty-sub">支持音标、释义、例句</text>
    </div>

    <!-- 错误提示 -->
    <div class="error" if="{{ errorMsg && !loading }}">
      <text class="error-text">{{ errorMsg }}</text>
    </div>
  </div>
</template>

<script>
import dictionary from '../../helper/apis/dictionary'

export default {
  private: {
    keyword: '',
    loading: false,
    result: null,
    errorMsg: '',
    quickWords: ['hello', 'world', 'apple', 'study', 'happy']
  },

  onKeywordChange(e) {
    this.keyword = e.value
  },

  onQuickWord(word) {
    this.keyword = word
    this.search(word)
  },

  onSearch() {
    const word = (this.keyword || '').trim()
    if (!word) {
      this.errorMsg = '请输入要查询的单词'
      this.result = null
      return
    }
    this.search(word)
  },

  search(word) {
    this.loading = true
    this.errorMsg = ''
    this.result = null

    dictionary
      .lookupWord(word)
      .then((data) => {
        if (data) {
          this.result = data
        } else {
          this.errorMsg = '未查询到结果'
        }
      })
      .catch((err) => {
        this.errorMsg = err.message || '查询失败'
      })
      .finally(() => {
        this.loading = false
      })
  }
}
</script>

<style lang="scss">
