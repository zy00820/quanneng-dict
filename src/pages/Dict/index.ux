  margin-left: 4px;
  border-radius: 18px;
  background-color: #4facfe;
  color: #ffffff;
  font-size: 13px;
}

.quick-words {
  flex-direction: row;
  width: 100%;
  flex-wrap: wrap;
  justify-content: center;
  padding-left: 8px;
  padding-right: 8px;
  margin-top: 4px;
}

.quick-word {
  font-size: 11px;
  color: #8ab4f8;
  background-color: #1a1a33;
