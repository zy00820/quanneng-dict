<!--
  全能词典 - 设置页面
-->

<template>
  <div class="page">
    <div class="title-bar">
      <text class="page-title">设置</text>
    </div>

    <div class="section">
      <div class="section-title">
        <text class="section-title-text">通用</text>
      </div>

      <div class="setting-item" onclick="onAbout">
        <div class="item-left">
          <text class="item-icon">ⓘ</text>
          <text class="item-label">关于</text>
        </div>
        <text class="item-arrow">›</text>
      </div>

      <div class="setting-item" onclick="onCheckUpdate">
        <div class="item-left">
          <text class="item-icon">↻</text>
          <text class="item-label">检查更新</text>
        </div>
        <text class="item-arrow">›</text>
      </div>
    </div>

    <div class="section">
      <div class="section-title">
        <text class="section-title-text">激活</text>
      </div>

      <div class="setting-item">
        <div class="item-left">
          <text class="item-icon">✓</text>
          <text class="item-label">激活状态</text>
        </div>
        <text class="item-status">{{ activated ? '已激活' : '未激活' }}</text>
      </div>
    </div>

    <div class="section">
      <div class="section-title">
        <text class="section-title-text">其他</text>
      </div>

      <div class="setting-item" onclick="onFeedback">
        <div class="item-left">
          <text class="item-icon">✉</text>
          <text class="item-label">意见反馈</text>
        </div>
        <text class="item-arrow">›</text>
      </div>

      <div class="setting-item" onclick="onJoinGroup">
        <div class="item-left">
          <text class="item-icon">💬</text>
          <text class="item-label">加入交流群</text>
        </div>
        <text class="item-arrow">›</text>
      </div>
    </div>

    <div class="footer-info">
      <text class="footer-text">全能词典 V1.0.3</text>
      <text class="footer-sub">小默软件工作室</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'
import clipboard from '@system.clipboard'

export default {
  private: {
    activated: false,
    qqGroup: '586352356',
    email: 'zy291817@outlook.com'
  },

  onInit() {
    this.$page.setTitleBar({ text: '设置' })
    this.checkActivation()
  },

  checkActivation() {
    storage.get({
      key: 'quanneng_dict_activated',
      success: (data) => {
        this.activated = data === 'true'
      },
      fail: () => {
        this.activated = false
      }
    })
  },

  onAbout() {
    router.push({ uri: '/pages/About' })
  },

  onCheckUpdate() {
    prompt.showToast({ message: '当前已是最新版本 V1.0.3' })
  },

  onFeedback() {
    clipboard.set({
      text: this.email,
      success: () => {
        prompt.showToast({ message: '反馈邮箱已复制：' + this.email })
      }
    })
  },

  onJoinGroup() {
    clipboard.set({
      text: this.qqGroup,
      success: () => {
        prompt.showToast({ message: '群号已复制：' + this.qqGroup })
      }
    })
  }
}
</script>

