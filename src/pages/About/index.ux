<!--
  全能词典 - 关于页面
-->

<template>
  <div class="page">
    <div class="header">
      <text class="app-name">全能词典</text>
      <text class="version">V1.0.3</text>
    </div>

    <div class="info-card">
      <div class="info-row">
        <text class="info-label">开发者</text>
        <text class="info-value">张岳</text>
      </div>

      <div class="divider"></div>

      <div class="info-row">
        <text class="info-label">开发团队</text>
        <text class="info-value">小默软件工作室</text>
      </div>

      <div class="divider"></div>

      <div class="info-row" onclick="copyEmail">
        <text class="info-label">联系方式</text>
        <text class="info-value email">{{ email }}</text>
      </div>

      <div class="divider"></div>

      <div class="info-row" onclick="copyQQ">
        <text class="info-label">交流群</text>
        <text class="info-value qq">{{ qqGroup }}</text>
      </div>
    </div>

    <div class="copy-tip">
      <text class="tip-text">点击邮箱或群号可复制</text>
    </div>

    <div class="footer">
      <text class="footer-text">© 2026 小默软件工作室</text>
      <text class="footer-sub">保留所有权利</text>
    </div>
  </div>
</template>

<script>
import prompt from '@system.prompt'
import clipboard from '@system.clipboard'

export default {
  private: {
    email: 'zy291817@outlook.com',
    qqGroup: '586352356'
  },

  onInit() {
    this.$page.setTitleBar({ text: '关于' })
  },

  copyEmail() {
    clipboard.set({
      text: this.email,
      success: () => {
        prompt.showToast({ message: '邮箱已复制' })
      }
    })
  },

  copyQQ() {
    clipboard.set({
      text: this.qqGroup,
      success: () => {
        prompt.showToast({ message: '群号已复制' })
      }
    })
  }
}
</script>

