<!--
  全能词典 - 自定义拼音键盘组件（轻量版）
  优化：减少DOM节点、去除嵌套for、防抖、移除scroll
-->

<template>
  <div class="keyboard-panel">
    <!-- 候选词栏（最多5个，横向排列） -->
    <div class="candidate-bar" if="{{ showCandidates }}">
      <text class="candidate-item" for="{{ candidates }}" onclick="onSelectCandidate($idx)">{{ $item }}</text>
    </div>

    <!-- 拼音缓冲显示 -->
    <text class="pinyin-buffer" if="{{ inputBuffer }}">{{ inputBuffer }}</text>

    <!-- 26键键盘 -->
    <div class="kb-26" if="{{ layout === '26' }}">
      <div class="kb-row">
        <text class="kb-key" onclick="onKey26('q')">q</text>
        <text class="kb-key" onclick="onKey26('w')">w</text>
        <text class="kb-key" onclick="onKey26('e')">e</text>
        <text class="kb-key" onclick="onKey26('r')">r</text>
        <text class="kb-key" onclick="onKey26('t')">t</text>
        <text class="kb-key" onclick="onKey26('y')">y</text>
        <text class="kb-key" onclick="onKey26('u')">u</text>
        <text class="kb-key" onclick="onKey26('i')">i</text>
        <text class="kb-key" onclick="onKey26('o')">o</text>
        <text class="kb-key" onclick="onKey26('p')">p</text>
      </div>
      <div class="kb-row">
        <text class="kb-key" onclick="onKey26('a')">a</text>
        <text class="kb-key" onclick="onKey26('s')">s</text>
        <text class="kb-key" onclick="onKey26('d')">d</text>
        <text class="kb-key" onclick="onKey26('f')">f</text>
        <text class="kb-key" onclick="onKey26('g')">g</text>
        <text class="kb-key" onclick="onKey26('h')">h</text>
        <text class="kb-key" onclick="onKey26('j')">j</text>
        <text class="kb-key" onclick="onKey26('k')">k</text>
        <text class="kb-key" onclick="onKey26('l')">l</text>
      </div>
      <div class="kb-row">
        <text class="kb-key" onclick="onKey26('z')">z</text>
        <text class="kb-key" onclick="onKey26('x')">x</text>
        <text class="kb-key" onclick="onKey26('c')">c</text>
        <text class="kb-key" onclick="onKey26('v')">v</text>
        <text class="kb-key" onclick="onKey26('b')">b</text>
        <text class="kb-key" onclick="onKey26('n')">n</text>
        <text class="kb-key" onclick="onKey26('m')">m</text>
      </div>
      <div class="kb-row kb-row-func">
        <text class="kb-key func-key" onclick="onToggleLang">{{ lang }}</text>
        <text class="kb-key func-key wide" onclick="onSpace">空格</text>
        <text class="kb-key func-key" onclick="onBackspace">⌫</text>
        <text class="kb-key func-key confirm-key" onclick="onConfirm">确定</text>
      </div>
    </div>

    <!-- 9键键盘 -->
    <div class="kb-9" if="{{ layout === '9' }}">
      <div class="kb-row-9">
        <text class="kb-key-9" onclick="onKey9({ num: '1', letters: '' })">1</text>
        <text class="kb-key-9" onclick="onKey9({ num: '2', letters: 'ABC' })">2 ABC</text>
        <text class="kb-key-9" onclick="onKey9({ num: '3', letters: 'DEF' })">3 DEF</text>
      </div>
      <div class="kb-row-9">
        <text class="kb-key-9" onclick="onKey9({ num: '4', letters: 'GHI' })">4 GHI</text>
        <text class="kb-key-9" onclick="onKey9({ num: '5', letters: 'JKL' })">5 JKL</text>
        <text class="kb-key-9" onclick="onKey9({ num: '6', letters: 'MNO' })">6 MNO</text>
      </div>
      <div class="kb-row-9">
        <text class="kb-key-9" onclick="onKey9({ num: '7', letters: 'PQRS' })">7 PQRS</text>
        <text class="kb-key-9" onclick="onKey9({ num: '8', letters: 'TUV' })">8 TUV</text>
        <text class="kb-key-9" onclick="onKey9({ num: '9', letters: 'WXYZ' })">9 WXYZ</text>
      </div>
      <div class="kb-row-9 kb-row-func-9">
        <text class="kb-key-9 func-key" onclick="onToggleLang">{{ lang }}</text>
        <text class="kb-key-9 func-key" onclick="onSpace">空格</text>
        <text class="kb-key-9 func-key" onclick="onBackspace">⌫</text>
        <text class="kb-key-9 func-key confirm-key" onclick="onConfirm">确定</text>
      </div>
    </div>

    <!-- 底部切换栏 -->
    <div class="bottom-bar">
      <text class="switch-btn" onclick="onToggleLayout">{{ layout === '26' ? '9键' : '26键' }}</text>
      <text class="switch-btn" onclick="onHideKeyboard">收起</text>
    </div>
  </div>
</template>

<script>
import pinyin from '../../helper/pinyin'

export default {
  private: {
    layout: '26',
    lang: '中',
    inputBuffer: '',
    candidates: [],
    showCandidates: false,
    debounceTimer: null
  },

  onKey26(key) {
    if (this.lang === 'EN') {
      this.$emit('input', key)
    } else {
      this.inputBuffer += key
      this.debouncedUpdate()
    }
  },

  onKey9(key) {
    if (key.num === '1') {
      this.$emit('input', ',')
      return
    }
    if (this.lang === 'EN') {
      this.$emit('input', key.letters[0].toLowerCase())
    } else {
      this.inputBuffer += key.num
      this.debouncedUpdate()
    }
  },

  // 防抖更新候选词，避免快速输入时频繁计算
  debouncedUpdate() {
    if (this.debounceTimer) {
      clearTimeout(this.debounceTimer)
    }
    this.debounceTimer = setTimeout(() => {
      this.updateCandidates()
    }, 200)
  },

  updateCandidates() {
    if (!this.inputBuffer) {
      this.candidates = []
      this.showCandidates = false
      return
    }
    let result
    if (this.layout === '26') {
      result = pinyin.getCandidates26(this.inputBuffer)
    } else {
      result = pinyin.getCandidatesT9(this.inputBuffer)
      result = result ? result.candidates : []
    }
    this.candidates = result.slice(0, 5)
    this.showCandidates = this.candidates.length > 0
  },

  onSelectCandidate(idx) {
    const word = this.candidates[idx]
    if (word) {
      this.$emit('input', word)
      this.inputBuffer = ''
      this.candidates = []
      this.showCandidates = false
    }
  },

  onSpace() {
    if (this.lang === 'EN') {
      this.$emit('input', ' ')
    } else if (this.candidates.length > 0) {
      this.onSelectCandidate(0)
    }
  },

  onBackspace() {
    if (this.inputBuffer.length > 0) {
      this.inputBuffer = this.inputBuffer.slice(0, -1)
      if (this.inputBuffer) {
        this.debouncedUpdate()
      } else {
        this.candidates = []
        this.showCandidates = false
      }
    } else {
      this.$emit('backspace')
    }
  },

  onConfirm() {
    if (this.inputBuffer && this.candidates.length > 0) {
      this.onSelectCandidate(0)
    }
    this.$emit('confirm')
  },

  onToggleLang() {
    this.lang = this.lang === '中' ? 'EN' : '中'
    this.inputBuffer = ''
    this.candidates = []
    this.showCandidates = false
  },

  onToggleLayout() {
    this.layout = this.layout === '26' ? '9' : '26'
    this.inputBuffer = ''
    this.candidates = []
    this.showCandidates = false
  },

  onHideKeyboard() {
    this.$emit('hide')
  }
}
</script>

<style lang="scss">
@import './../../assets/styles/style.scss';

.keyboard-panel {
  width: 100%;
  flex-direction: column;
  background-color: #1a1a2e;
  border-top-width: 1px;
  border-top-color: #2a2a4e;
  padding-bottom: 4px;
}

.candidate-bar {
  width: 100%;
  height: 32px;
  flex-direction: row;
  align-items: center;
  padding-left: 4px;
  padding-right: 4px;
  background-color: #14142a;
}

.candidate-item {
  font-size: 14px;
  color: #ffffff;
  background-color: #2a2a4e;
  border-radius: 4px;
  padding: 2px 8px;
  margin-right: 4px;
  text-align: center;
}

.pinyin-buffer {
  width: 100%;
  height: 22px;
  font-size: 12px;
  color: #ffd700;
  text-align: center;
  background-color: #0f0f1e;
}

.kb-26,
.kb-9 {
  width: 100%;
  flex-direction: column;
  padding: 2px;
}

.kb-row {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-bottom: 2px;
}

.kb-key {
  width: 32px;
  height: 30px;
  background-color: #2a2a4e;
  border-radius: 4px;
  font-size: 13px;
  color: #ffffff;
  text-align: center;
  margin: 0 1px;
}

.kb-key:active {
  background-color: #4facfe;
}

.kb-row-func {
  margin-top: 1px;
}

.func-key {
  background-color: #3a3a5e;
}

.wide {
  width: 60px;
}

.confirm-key {
  background-color: #4facfe;
}

/* 9键键盘 */
.kb-row-9 {
  flex-direction: row;
  justify-content: center;
  width: 100%;
  margin-bottom: 2px;
}

.kb-key-9 {
  width: 72px;
  height: 34px;
  background-color: #2a2a4e;
  border-radius: 6px;
  font-size: 13px;
  color: #ffffff;
  text-align: center;
  margin: 0 2px;
}

.kb-key-9:active {
  background-color: #4facfe;
}

.kb-row-func-9 .kb-key-9 {
  width: 62px;
  height: 32px;
}

.bottom-bar {
  width: 100%;
  height: 26px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-left: 8px;
  padding-right: 8px;
  background-color: #0f0f1e;
}

.switch-btn {
  font-size: 11px;
  color: #4facfe;
}
</style>
